    <string name="type_noun_name">Noun</string>
    <string name="type_noun_desc">A person, thing, place or idea. E.g. dog, city, love</string>
    <string name="type_noun_pos">Position: at the start of a clause (subject) or after the verb (object). E.g. The dog runs. / I love dogs.</string>
    <string name="type_verb_name">Verb</string>
    <string name="type_verb_desc">An action or a state. E.g. run, is, think</string>
    <string name="type_verb_pos">Position: after the subject; it is the core of the clause. E.g. She runs. / He is happy.</string>
    <string name="type_adjective_name">Adjective</string>
    <string name="type_adjective_desc">Describes a quality of a noun. E.g. big, happy, red</string>
    <string name="type_adjective_pos">Position: before a noun (big dog) or after \'be\' (He is big).</string>
    <string name="type_adverb_name">Adverb</string>
    <string name="type_adverb_desc">Modifies a verb, an adjective or a whole clause. E.g. quickly, very, often</string>
    <string name="type_adverb_pos">Position: flexible — before or after the verb (runs quickly), before an adjective (very big).</string>
    <string name="type_pronoun_name">Pronoun</string>
    <string name="type_pronoun_desc">Stands in for a noun already mentioned. E.g. he, they, it, someone</string>
    <string name="type_pronoun_pos">Position: same as a noun — subject at the start, or object after the verb. E.g. She runs.</string>
    <string name="type_preposition_name">Preposition</string>
    <string name="type_preposition_desc">Shows a relationship of place, time or manner. E.g. in, on, after, with</string>
    <string name="type_preposition_pos">Position: before a noun, forming a prepositional phrase. E.g. in the morning / at the park.</string>
    <string name="type_conjunction_name">Conjunction</string>
    <string name="type_conjunction_desc">Joins words, phrases or clauses. E.g. and, but, because, although</string>
    <string name="type_conjunction_pos">Position: between the two elements it joins. E.g. I run and she walks. / I stayed because it rained.</string>
    <string name="type_article_name">Article</string>
    <string name="type_article_desc">Marks a noun as definite (the) or indefinite (a/an). E.g. a, an, the</string>
    <string name="type_article_pos">Position: directly before the noun, or before adjective + noun. E.g. the dog / a big dog.</string>
    <string name="type_determiner_name">Determiner</string>
    <string name="type_determiner_desc">Comes before a noun to limit or specify its meaning. E.g. this, some, every, my</string>
    <string name="type_determiner_pos">Position: before the noun, replacing or adding to an article. E.g. this book / every day.</string>
    <string name="type_numeral_name">Numeral</string>
    <string name="type_numeral_desc">Gives a quantity or an order. E.g. one, three, first, twice</string>
    <string name="type_numeral_pos">Position: before a noun (three dogs) or after the verb (He arrived first).</string>
    <string name="type_interjection_name">Interjection</string>
    <string name="type_interjection_desc">Expresses a feeling or an immediate reaction. E.g. wow, oops, hey, oh</string>
    <string name="type_interjection_pos">Position: stands alone at the start, set off by a comma or exclamation mark. E.g. Wow, that\'s great!</string>
    <string name="type_particle_name">Particle</string>
    <string name="type_particle_desc">Modifies the verb in a phrasal verb, changing its meaning entirely. E.g. up, off, out, on</string>
    <string name="type_particle_pos">Position: after the verb in a phrasal verb. E.g. give up / turn off / run out of.</string>
    <string name="role_subject_name">Subject</string>
    <string name="role_subject_desc">The person, thing or idea performing the action. Usually first in the clause. E.g. The cat runs. / She sings.</string>
    <string name="role_predicate_name">Predicate</string>
    <string name="role_predicate_desc">The part of the clause containing the verb, describing the subject\'s action or state. E.g. runs quickly / is very happy.</string>
    <string name="role_direct_object_name">Direct Object</string>
    <string name="role_direct_object_desc">The person or thing directly receiving the action; answers \'What?\' or \'Who?\'. E.g. She reads a book.</string>
    <string name="role_indirect_object_name">Indirect Object</string>
    <string name="role_indirect_object_desc">The person or thing that benefits, usually placed before the direct object. E.g. She gave him a gift.</string>
    <string name="role_complement_name">Complement</string>
    <string name="role_complement_desc">Completes the meaning of the subject or object through a linking verb (be, seem, become). E.g. She is a teacher. / He looks tired.</string>
    <string name="role_adverbial_name">Adverbial</string>
    <string name="role_adverbial_desc">Gives information about time, place, manner or reason. Its position is flexible. E.g. In the morning, she runs.</string>
    <string name="role_modifier_name">Modifier</string>
    <string name="role_modifier_desc">Modifies a noun, sitting before or after it. E.g. the big red dog / a cup of coffee.</string>
    <string name="role_appositive_name">Appositive</string>
    <string name="role_appositive_desc">A phrase placed next to a noun to explain it further. E.g. My friend, a doctor, arrived.</string>
    <string name="role_relative_clause_name">Relative Clause</string>
    <string name="role_relative_clause_desc">A clause beginning with who, which or that that modifies a noun. E.g. The book that I read was great.</string>
    <string name="role_noun_clause_name">Noun Clause</string>
    <string name="role_noun_clause_desc">A clause acting as a noun (subject or object). E.g. What she said was true.</string>
    <string name="role_adverb_clause_name">Adverb Clause</string>
    <string name="role_adverb_clause_desc">A clause beginning with because, when, if or although. E.g. Because it rained, we stayed home.</string>
</resources>
