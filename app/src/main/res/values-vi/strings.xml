    <string name="type_noun_name">Danh từ</string>
    <string name="type_noun_desc">Người, vật, nơi chốn hoặc ý tưởng. VD: dog, city, love</string>
    <string name="type_noun_pos">Vị trí: Đầu câu (chủ ngữ) hoặc sau động từ (tân ngữ). VD: The dog runs. / I love dogs.</string>
    <string name="type_verb_name">Động từ</string>
    <string name="type_verb_desc">Hành động hoặc trạng thái. VD: run, is, think</string>
    <string name="type_verb_pos">Vị trí: Sau chủ ngữ, là trung tâm của câu. VD: She runs. / He is happy.</string>
    <string name="type_adjective_name">Tính từ</string>
    <string name="type_adjective_desc">Mô tả tính chất của danh từ. VD: big, happy, red</string>
    <string name="type_adjective_pos">Vị trí: Trước danh từ (big dog) hoặc sau động từ \'be\' (He is big).</string>
    <string name="type_adverb_name">Trạng từ</string>
    <string name="type_adverb_desc">Bổ nghĩa cho động từ, tính từ hoặc câu. VD: quickly, very, often</string>
    <string name="type_adverb_pos">Vị trí: Linh hoạt — trước/sau động từ (runs quickly), trước tính từ (very big).</string>
    <string name="type_pronoun_name">Đại từ</string>
    <string name="type_pronoun_desc">Thay thế danh từ đã đề cập. VD: he, they, it, someone</string>
    <string name="type_pronoun_pos">Vị trí: Tương tự danh từ — đầu câu (chủ ngữ) hoặc sau động từ (tân ngữ). VD: She runs.</string>
    <string name="type_preposition_name">Giới từ</string>
    <string name="type_preposition_desc">Chỉ mối quan hệ vị trí, thời gian, cách thức. VD: in, on, after, with</string>
    <string name="type_preposition_pos">Vị trí: Trước danh từ, tạo thành cụm giới từ. VD: in the morning / at the park.</string>
    <string name="type_conjunction_name">Liên từ</string>
    <string name="type_conjunction_desc">Nối từ, cụm từ hoặc mệnh đề. VD: and, but, because, although</string>
    <string name="type_conjunction_pos">Vị trí: Giữa hai thành phần cần nối. VD: I run and she walks. / I stayed because it rained.</string>
    <string name="type_article_name">Mạo từ</string>
    <string name="type_article_desc">Xác định danh từ là xác định (the) hay không xác định (a/an). VD: a, an, the</string>
    <string name="type_article_pos">Vị trí: Ngay trước danh từ hoặc trước tính từ + danh từ. VD: the dog / a big dog.</string>
    <string name="type_determiner_name">Từ hạn định</string>
    <string name="type_determiner_desc">Đứng trước danh từ để giới hạn hoặc xác định nghĩa. VD: this, some, every, my</string>
    <string name="type_determiner_pos">Vị trí: Trước danh từ (thay thế hoặc bổ sung cho mạo từ). VD: this book / every day.</string>
    <string name="type_numeral_name">Số từ</string>
    <string name="type_numeral_desc">Chỉ số lượng hoặc thứ tự. VD: one, three, first, twice</string>
    <string name="type_numeral_pos">Vị trí: Trước danh từ (three dogs) hoặc sau động từ (He arrived first).</string>
    <string name="type_interjection_name">Thán từ</string>
    <string name="type_interjection_desc">Biểu đạt cảm xúc hoặc phản ứng tức thì. VD: wow, oops, hey, oh</string>
    <string name="type_interjection_pos">Vị trí: Đứng độc lập đầu câu, thường cách câu chính bằng dấu phẩy hoặc chấm than. VD: Wow, that\'s great!</string>
    <string name="type_particle_name">Tiểu từ</string>
    <string name="type_particle_desc">Bổ nghĩa cho động từ trong phrasal verb, thay đổi nghĩa hoàn toàn. VD: up, off, out, on</string>
    <string name="type_particle_pos">Vị trí: Sau động từ trong phrasal verb. VD: give up / turn off / run out of.</string>
    <string name="role_subject_name">Chủ ngữ</string>
    <string name="role_subject_desc">Người, vật hoặc ý niệm thực hiện hành động. Thường đứng đầu câu. VD: The cat runs. / She sings.</string>
    <string name="role_predicate_name">Vị ngữ</string>
    <string name="role_predicate_desc">Phần câu chứa động từ, mô tả hành động hoặc trạng thái của chủ ngữ. VD: runs quickly / is very happy.</string>
    <string name="role_direct_object_name">Tân ngữ trực tiếp</string>
    <string name="role_direct_object_desc">Người/vật nhận trực tiếp hành động, trả lời câu hỏi \'What?\' hoặc \'Who?\'. VD: She reads a book.</string>
    <string name="role_indirect_object_name">Tân ngữ gián tiếp</string>
    <string name="role_indirect_object_desc">Người/vật được hưởng lợi, thường đứng trước tân ngữ trực tiếp. VD: She gave him a gift.</string>
    <string name="role_complement_name">Bổ ngữ</string>
    <string name="role_complement_desc">Bổ sung ý nghĩa cho chủ ngữ/tân ngữ qua linking verb (be, seem, become). VD: She is a teacher. / He looks tired.</string>
    <string name="role_adverbial_name">Trạng ngữ</string>
    <string name="role_adverbial_desc">Cung cấp thông tin về thời gian, nơi chốn, cách thức, lý do. Vị trí linh hoạt. VD: In the morning, she runs.</string>
    <string name="role_modifier_name">Định ngữ</string>
    <string name="role_modifier_desc">Bổ nghĩa cho danh từ, đứng trước hoặc sau danh từ đó. VD: the big red dog / a cup of coffee.</string>
    <string name="role_appositive_name">Đồng vị ngữ</string>
    <string name="role_appositive_desc">Cụm từ đứng cạnh và giải thích thêm cho danh từ đứng trước. VD: My friend, a doctor, arrived.</string>
    <string name="role_relative_clause_name">Mệnh đề quan hệ</string>
    <string name="role_relative_clause_desc">Mệnh đề bắt đầu bằng who, which, that bổ nghĩa cho danh từ. VD: The book that I read was great.</string>
    <string name="role_noun_clause_name">Mệnh đề danh từ</string>
    <string name="role_noun_clause_desc">Mệnh đề giữ chức năng của danh từ (chủ ngữ hoặc tân ngữ). VD: What she said was true.</string>
    <string name="role_adverb_clause_name">Mệnh đề trạng từ</string>
    <string name="role_adverb_clause_desc">Mệnh đề bắt đầu bằng because, when, if, although. VD: Because it rained, we stayed home.</string>
</resources>
